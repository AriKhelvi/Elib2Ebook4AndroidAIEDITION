<?xml version="1.0" encoding="utf-8"?>
<!-- Глобальный NuGet.Config на этой машине без источников, поэтому задаём nuget.org явно для проекта. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
