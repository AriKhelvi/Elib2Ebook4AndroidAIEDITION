<!--
  ============================================================================
  E2E для Android — проект приложения (.NET MAUI Blazor Hybrid, .NET 10)
  ============================================================================
  [AI-EDITION] Этот проект целиком сгенерирован ИИ (Claude, Anthropic) по запросу и под присмотром человека.
  Он собирается и проверялся выборочно, но СТАБИЛЬНОСТЬ НЕ ГАРАНТИРУЕТСЯ. Используйте на свой риск,
  о проблемах пишите в Issues форка.

  Как это устроено:
  - интерфейс — Razor-компоненты в BlazorWebView (по мотивам веб-версии Elib2EbookWeb);
  - вся работа с сайтами и форматами — это ядро Elib2Ebook из ../../src, подключённое как ProjectReference
    без изменений в логике (то же самое, что делает консольная утилита);
  - Android-специфика (сохранение файлов, фоновый сервис, «Поделиться») — в Platforms/Android.
  ============================================================================
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Только Android: iOS/Windows/macOS в этом проекте не нужны и не собираются -->
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>E2E.Droid</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Ядро написано без nullable-аннотаций — держим тот же режим, чтобы не утонуть в предупреждениях -->
        <Nullable>disable</Nullable>
        <!-- CSS обрабатывает Blazor (wwwroot), а не MAUI -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <!-- XAML компилируется генератором исходников — быстрее запуск -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>E2E</ApplicationTitle>
        <!-- Идентификатор пакета. Если поменять — Android будет считать это другим приложением -->
        <ApplicationId>e2e.droid</ApplicationId>
        <!-- Версия приложения (versionName) — от git-тега vX.Y.Z, versionCode — растущий номер сборки.
             Их подставляют android/build.ps1 и CI (см. android/README.md, раздел «Версии»);
             без растущего versionCode Android откажется ставить обновление поверх. -->
        <ApplicationDisplayVersion>0.0.0-dev</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Android 7.0+. Ниже не пускает сам BlazorWebView (MAUI поддерживает его только с API 24).
             На Android 7–9 книги пишутся в «Загрузки» по пути (с разрешением на память), с Android 10 — через MediaStore
             без разрешений; см. AndroidBookStorage. -->
        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

        <!-- Архитектуры. arm64 — Pixel 9a и почти все современные телефоны;
             arm (32 бита) — старые телефоны и большинство читалок на Android 7–10. Обе — в одном APK.
             Для эмулятора: -p:E2EAbi=android-arm64+android-x64 (или build.cmd -Abi android-arm64,android-x64).
             Разделитель в командной строке — «+»: «;» и «,» в -p: MSBuild считает разделителями свойств.
             ВАЖНО: не передавайте -p:RuntimeIdentifiers в командной строке — глобальное свойство уходит во все
             60+ библиотек ядра, и их сборка ломается. Поэтому архитектуры передаются через своё свойство E2EAbi. -->
        <E2EAbi Condition="'$(E2EAbi)' == ''">android-arm64+android-arm</E2EAbi>
        <_E2EAbiList>+$(E2EAbi.Replace(';', '+').Replace(',', '+').Replace(' ', '+'))+</_E2EAbiList>
        <!-- Список RuntimeIdentifiers собирается условиями из известных архитектур. Просто заменить «+» на «;»
             строковой функцией нельзя: результат функции MSBuild экранирует, и «;» в нём не делит список —
             получился бы один «RID» вида android-arm64;android-arm (ошибка NETSDK1083). -->
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-arm64+'))">android-arm64</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-arm+')) and '$(_E2ERids)' != ''">$(_E2ERids);android-arm</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-arm+')) and '$(_E2ERids)' == ''">android-arm</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-x64+')) and '$(_E2ERids)' != ''">$(_E2ERids);android-x64</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-x64+')) and '$(_E2ERids)' == ''">android-x64</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-x86+')) and '$(_E2ERids)' != ''">$(_E2ERids);android-x86</_E2ERids>
        <_E2ERids Condition="$(_E2EAbiList.Contains('+android-x86+')) and '$(_E2ERids)' == ''">android-x86</_E2ERids>
        <RuntimeIdentifiers>$(_E2ERids)</RuntimeIdentifiers>

        <!-- Ядро использует HTTP/2 и свои настройки HttpClientHandler (cookies, прокси, распаковка).
             Нативный AndroidMessageHandler HTTP/2 не умеет, поэтому включаем управляемый SocketsHttpHandler —
             тот же, что работает в консольной версии на ПК. -->
        <UseNativeHttpHandler>false</UseNativeHttpHandler>
        <!-- Загрузчики сайтов разбирают JSON через рефлексию (без source generators) -->
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <!-- Тримминг (уменьшение размера) — только для сборок, помеченных как trimmable (фреймворк, MAUI).
             Код ядра не триммится: он рассчитан на рефлексию. -->
        <TrimMode>partial</TrimMode>
        <!-- Тексты исключений .NET оставляем в APK: без этого Release-сборка показывает в ошибках и журнале служебные
             ключи вместо сообщений («net_http_request_timedout, 20»). Найдено журналом диагностики; APK чуть больше. -->
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- APK для установки вручную (по умолчанию Release собирает AAB для Google Play) -->
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Корень репозитория (форк Elib2Ebook): там лежат src/, README.md и Directory.Build.props ядра -->
        <E2ECoreDir>$(MSBuildThisFileDirectory)..\..\</E2ECoreDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- Иконка и заставка генерируются из SVG при сборке (MAUI Resizetizer) -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0071E3" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0071E3" BaseSize="128,128" />
    </ItemGroup>

    <ItemGroup>
        <!-- Версии берутся из установленного workload'а MAUI (см. ../Directory.Packages.props, почему не централизованно) -->
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    </ItemGroup>

    <!-- Ядро Elib2Ebook и ВСЕ проекты сайтов. Маска ** означает: новый сайт, добавленный в ядро,
         автоматически попадёт в приложение при следующей сборке. -->
    <ItemGroup>
        <ProjectReference Include="$(E2ECoreDir)src\Elib2Ebook.DomainServices\Elib2Ebook.DomainServices.csproj" />
        <ProjectReference Include="$(E2ECoreDir)src\ExternalServices\**\*.csproj" />
    </ItemGroup>

    <!--
      Нерабочие сайты. Проверено 2026-10-28 из сети владельца форка: домен через публичный DNS (dns.google) и
      главная страница сайта (curl, 20–40 с). Обход защит сайтов (Cloudflare и т.п.) приложение не делает, поэтому
      сайты, которые всегда показывают проверку «вы не робот», тоже считаются нерабочими.
      - E2EDisabledLoader — загрузчик целиком не попадает в APK (все его сайты мертвы).
      - E2EDeadSite — домен скрывается из вкладки «Сайты» и объясняется там (Reason); у живых загрузчиков
        с несколькими доменами так прячутся только мёртвые домены.
      Сайт ожил — уберите его отсюда (загрузчики остаются в ядре, в src/ExternalServices).
      В Reason нельзя «;», кавычки, «%», «$» и «@» — список превращается в C#-код (см. E2EGenerateExternalServicesList).
    -->
    <ItemGroup Label="Нерабочие сайты">
        <E2EDisabledLoader Include="Bookinist;Desu;IGram;Libbox;Litmir;Ranobe;Romfant;MirKnig;OnlineKnigi;DarkNovels;FanFicus;ReadManga;Librebook;BookInBook;Libst;Novelxo;WuxiaWorld;HubBook;Novelhall" />

        <E2EDeadSite Include="bookinist.pw" Reason="домена больше нет в DNS" />
        <E2EDeadSite Include="desu.me" Reason="домен не находится в публичном DNS" />
        <E2EDeadSite Include="i-gram.ru" Reason="домен не находится в публичном DNS" />
        <E2EDeadSite Include="libbox.ru" Reason="домена больше нет в DNS" />
        <E2EDeadSite Include="litmir.me" Reason="домена больше нет в DNS" />
        <E2EDeadSite Include="ранобэ.рф" Reason="DNS домена не отвечает" />
        <E2EDeadSite Include="romfant.ru" Reason="DNS домена не отвечает, сайт не открывается" />
        <E2EDeadSite Include="mir-knig.com" Reason="домен выставлен на продажу" />
        <E2EDeadSite Include="online-knigi.com.ua" Reason="домен перехвачен — ведёт на сайт казино" />
        <E2EDeadSite Include="dark-novels.ru" Reason="сайт отвечает «Сайт недоступен» (503)" />
        <E2EDeadSite Include="fanficus.com" Reason="сайт закрыт на обслуживание (503)" />
        <E2EDeadSite Include="readmanga.live" Reason="по этому адресу сайта больше нет (404)" />
        <E2EDeadSite Include="librebook.me" Reason="по этому адресу сайта больше нет (404)" />
        <E2EDeadSite Include="bookinbook.ru" Reason="сайт не отвечает" />
        <E2EDeadSite Include="libst.ru" Reason="сайт не отвечает" />
        <E2EDeadSite Include="novelxo.com" Reason="сайт не отвечает" />
        <E2EDeadSite Include="ru.novelxo.com" Reason="сайт не отвечает" />
        <E2EDeadSite Include="wuxiaworld.ru" Reason="сайт не отвечает" />
        <E2EDeadSite Include="hub-book.com" Reason="всегда показывает проверку Cloudflare — без браузера не пройти" />
        <E2EDeadSite Include="novelhall.com" Reason="всегда показывает проверку Cloudflare — без браузера не пройти" />
        <!-- Мёртвые домены живых загрузчиков -->
        <E2EDeadSite Include="bigliba.com" Reason="домен истёк (остался topliba.com)" />
        <E2EDeadSite Include="eznovels.com" Reason="домен ведёт на рекламу (остался hotnovelpub.com)" />
        <E2EDeadSite Include="lanovels.com" Reason="домена больше нет в DNS (остался hotnovelpub.com)" />
        <E2EDeadSite Include="lightnoveldaily.com" Reason="домена больше нет в DNS (остался hotnovelpub.com)" />
        <E2EDeadSite Include="novel.ovh" Reason="домена больше нет в DNS (остался manga.ovh)" />
        <E2EDeadSite Include="erolate.com" Reason="сайт не отвечает (522) — остальные сайты Rulate работают" />
        <E2EDeadSite Include="mlate.ru" Reason="ошибка защищённого соединения — остальные сайты Rulate работают" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Remove="@(E2EDisabledLoader->'$(E2ECoreDir)src\ExternalServices\Elib2Ebook.ExternalServices.%(Identity)\Elib2Ebook.ExternalServices.%(Identity).csproj')" />
    </ItemGroup>

    <!-- README ядра вшивается в приложение: из раздела «Поддерживаемые сайты» строится вкладка «Сайты» -->
    <ItemGroup>
        <EmbeddedResource Include="$(E2ECoreDir)README.md" LogicalName="Elib2Ebook.README.md" Visible="false" />
    </ItemGroup>

    <!-- Публичные корни для проверки сертификатов на старых устройствах (см. Services/CertificatePolicy.cs) -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\Certificates\trusted-roots.pem" LogicalName="E2E.Droid.trusted-roots.pem" />
        <EmbeddedResource Include="Resources\Certificates\trusted-bridges.pem" LogicalName="E2E.Droid.trusted-bridges.pem" />
    </ItemGroup>

    <!-- Загрузчики сайтов находятся рефлексией, прямых ссылок на них в коде нет — без этих строк тримминг
         выкинул бы их из APK. Корним сборки ядра и его сторонние библиотеки целиком.
         Имена — это имена DLL, а не NuGet-пакетов (например, пакет OAuth.DotNetCore даёт OAuth.dll). -->
    <ItemGroup>
        <TrimmerRootAssembly Include="Elib2Ebook.Domain" />
        <TrimmerRootAssembly Include="Elib2Ebook.DomainServices" />
        <TrimmerRootAssembly Include="EpubSharp" />
        <TrimmerRootAssembly Include="AngleSharp" />
        <TrimmerRootAssembly Include="HtmlAgilityPack" />
        <TrimmerRootAssembly Include="HtmlAgilityPack.CssSelectors.NetCore" />
        <TrimmerRootAssembly Include="FlareSolverrSharp" />
        <TrimmerRootAssembly Include="StringTokenFormatter" />
        <TrimmerRootAssembly Include="OAuth" />
    </ItemGroup>

    <!--
      Генерация списка сборок сайтов (obj/.../E2EExternalServices.g.cs).
      Штатный GetterFactory ядра ищет их через deps.json или по файлам *.dll рядом с exe — на Android
      ни того ни другого нет (сборки упакованы внутрь APK). Поэтому список имён берётся из ProjectReference
      прямо во время сборки, а GetterResolver грузит сборки по этим именам. Каждая из них заодно
      добавляется в TrimmerRootAssembly.
    -->
    <Target Name="E2EGenerateExternalServicesList" BeforeTargets="CoreCompile;PrepareForBuild">
        <PropertyGroup>
            <_E2EServicesFile>$(IntermediateOutputPath)E2EExternalServices.g.cs</_E2EServicesFile>
        </PropertyGroup>
        <ItemGroup>
            <_E2EServiceProject Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Elib2Ebook.ExternalServices.'))" />
            <!-- %3B — это «;», в MSBuild его нужно экранировать -->
            <_E2ELine Include="// &lt;auto-generated/&gt; из ProjectReference в E2E.Droid.csproj" />
            <_E2ELine Include="namespace E2E.Droid.Services%3B" />
            <_E2ELine Include="internal static class ExternalServicesList" />
            <_E2ELine Include="{" />
            <_E2ELine Include="    public static readonly string[] AssemblyNames =" />
            <_E2ELine Include="    [" />
            <_E2ELine Include="@(_E2EServiceProject->'        &quot;%(Filename)&quot;,')" />
            <_E2ELine Include="    ]%3B" />
            <_E2ELine Include="    // Нерабочие сайты: домен и причина (E2EDeadSite выше)" />
            <_E2ELine Include="    public static readonly (string Host, string Reason)[] DisabledSites =" />
            <_E2ELine Include="    [" />
            <_E2ELine Include="@(E2EDeadSite->'        (&quot;%(Identity)&quot;, &quot;%(Reason)&quot;),')" />
            <_E2ELine Include="    ]%3B" />
            <_E2ELine Include="}" />
            <TrimmerRootAssembly Include="@(_E2EServiceProject->'%(Filename)')" />
        </ItemGroup>
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <WriteLinesToFile File="$(_E2EServicesFile)" Lines="@(_E2ELine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Remove="$(_E2EServicesFile)" />
            <Compile Include="$(_E2EServicesFile)" />
            <FileWrites Include="$(_E2EServicesFile)" />
        </ItemGroup>
    </Target>

    <!-- Версия ядра (из ../../Directory.Build.props) и коммит форка, из которого собран APK (передают build.ps1 и CI), —
         для экрана «О приложении». Версия самого приложения берётся из versionName (AppInfo.VersionString). -->
    <Target Name="E2ECoreVersion" BeforeTargets="GetAssemblyAttributes">
        <XmlPeek XmlInputPath="$(E2ECoreDir)Directory.Build.props" Query="/Project/PropertyGroup/Version/text()">
            <Output TaskParameter="Result" PropertyName="E2ECoreVersionValue" />
        </XmlPeek>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>Elib2EbookVersion</_Parameter1>
                <_Parameter2>$(E2ECoreVersionValue)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildCommit</_Parameter1>
                <_Parameter2>$(E2ECommit)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

</Project>
