@* E2E для Android — всплывающие сообщения (snackbar Material 3) над нижней панелью
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@implements IDisposable
@inject ToastService ToastService

@if (ToastService.Toasts.Count > 0)
{
    <div class="snackbars" aria-live="polite">
        @foreach (var toast in ToastService.Toasts)
        {
            @* Нажатие убирает сообщение раньше времени *@
            <div class="snackbar snackbar-@toast.Kind.ToString().ToLowerInvariant()" role="status" @key="toast.Id" @onclick="() => ToastService.Dismiss(toast.Id)">
                <Icon Name="@(toast.Kind == ToastKind.Error ? "error" : toast.Kind == ToastKind.Success ? "check-circle" : "info")" Size="20" />
                <span>@toast.Text</span>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized() => ToastService.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ToastService.Changed -= OnChanged;
}
