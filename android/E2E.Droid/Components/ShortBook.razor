@* E2E для Android — карточка книги: обложка, название, автор, серия, сайт, аннотация
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
<div class="book-summary">
    @* Обложки бывают не у всех книг — тогда вместо неё значок *@
    <div class="book-cover @(Compact ? "small" : "")">
        @if (!string.IsNullOrEmpty(Book.CoverDataUrl))
        {
            <img src="@Book.CoverDataUrl" alt="Обложка" />
        }
        else
        {
            <Icon Name="book" Size="@(Compact ? 22 : 28)" />
        }
    </div>
    <div class="book-info">
        <h2 class="book-title">
            @if (string.IsNullOrEmpty(Book.Url))
            {
                @(Book.Title ?? "Без названия")
            }
            else
            {
                <a href="@Book.Url" target="_blank" rel="noopener">@(Book.Title ?? "Без названия")</a>
            }
        </h2>

        @if (!string.IsNullOrWhiteSpace(Book.Author))
        {
            <span class="book-meta">
                @if (string.IsNullOrEmpty(Book.AuthorUrl))
                {
                    @Book.Author
                }
                else
                {
                    <a href="@Book.AuthorUrl" target="_blank" rel="noopener">@Book.Author</a>
                }
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(Book.Seria))
        {
            <span class="book-meta">
                Серия:
                @if (string.IsNullOrEmpty(Book.SeriaUrl))
                {
                    @Book.Seria
                }
                else
                {
                    <a href="@Book.SeriaUrl" target="_blank" rel="noopener">@Book.Seria</a>
                }
            </span>
        }

        @if (!Compact && Host != null)
        {
            <span class="book-host">@Host</span>
        }
    </div>
</div>

@if (!Compact && SafeHtml.Clean(Book.Annotation) is { } annotation)
{
    <div class="book-annotation">@((MarkupString)annotation)</div>
}

@code {
    [Parameter, EditorRequired]
    public BookPreview Book { get; set; }

    /// <summary>Компактно (в карточке «Готово»): маленькая обложка, без сайта и аннотации.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private string Host => Uri.TryCreate(Book.Url, UriKind.Absolute, out var uri) ? uri.Host : null;
}
