@* E2E для Android — главный экран: результат, ссылка, прогресс или форма скачивания, журнал (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/"
@implements IDisposable
@inject DownloadManager Downloads
@inject AppSettings Settings
@inject FormState Form
@inject CredentialStore Credentials
@inject IBookStorage Storage
@inject ToastService Toasts
@inject IJSRuntime Js

@{
    var log = Downloads.Log;
    var saved = Downloads.Saved.Where(f => string.IsNullOrEmpty(f.Folder)).ToList();
    var extra = Downloads.Saved.Count - saved.Count;
    var errors = Downloads.Errors;
    var finished = !Downloads.IsRunning && Downloads.State != DownloadState.Idle;
}

<div class="page">
    @* Итог прошлого скачивания — сверху, чтобы не листать до него *@
    @if (finished && saved.Count > 0)
    {
        <section class="card" aria-label="Результат">
            <div class="card-header">
                <span class="card-header-icon"><Icon Name="check-circle" /></span>
                <div class="card-header-text">
                    <h2 class="card-title">@(errors.Count == 0 ? "Готово" : "Готово, но не всё")</h2>
                    <p class="card-subtitle">Сохранено в «@Storage.DestinationLabel»@(extra > 0 ? $", плюс доп. файлов: {extra}" : "")</p>
                </div>
                <button type="button" class="icon-button" aria-label="Скрыть результат" @onclick="Downloads.Dismiss"><Icon Name="close" /></button>
            </div>
            @if (Downloads.Preview != null)
            {
                <div class="card-section"><ShortBook Book="Downloads.Preview" Compact="true" /></div>
            }
            <div class="list">
                @foreach (var file in saved)
                {
                    <FileRow File="file" @key="file.Id" />
                }
            </div>
            @if (saved.Count > 1)
            {
                <div class="card-actions">
                    <button type="button" class="btn btn-tonal btn-block" @onclick="() => Storage.Share(saved)">
                        <Icon Name="share" Size="18" />Поделиться всеми (@saved.Count)
                    </button>
                </div>
            }
        </section>
    }

    @if (finished && errors.Count > 0)
    {
        <section class="card card-error" aria-label="Ошибки">
            <div class="card-header">
                <span class="card-header-icon"><Icon Name="error" /></span>
                <div class="card-header-text"><h2 class="card-title">Не получилось</h2></div>
                @if (saved.Count == 0)
                {
                    <button type="button" class="icon-button" aria-label="Скрыть" @onclick="Downloads.Dismiss"><Icon Name="close" /></button>
                }
            </div>
            <div class="card-body">
                @foreach (var error in errors)
                {
                    <p class="error-text">@error</p>
                }
                <p class="card-subtitle">Подробности — в журнале ниже. Если сайт требует входа, заполните «Вход на сайт»; при таймаутах увеличьте таймаут в настройках.</p>
            </div>
        </section>
    }

    <!-- Ссылка -->
    <div class="field">
        <div class="text-field multiline has-trailing @(Downloads.IsRunning ? "disabled" : "")">
            <label class="text-field-label" for="url-input">Ссылка на книгу</label>
            <textarea id="url-input" class="text-field-input" rows="@UrlRows"
                      placeholder="https://author.today/work/…"
                      autocapitalize="off" autocomplete="off" spellcheck="false" inputmode="url"
                      disabled="@Downloads.IsRunning"
                      @bind="Form.Urls" @bind:event="oninput" @bind:after="OnUrlsChanged"></textarea>
            @if (!Downloads.IsRunning)
            {
                @if (string.IsNullOrWhiteSpace(Form.Urls))
                {
                    <button type="button" class="icon-button text-field-trailing" aria-label="Вставить ссылку из буфера" @onclick="Paste"><Icon Name="paste" /></button>
                }
                else
                {
                    <button type="button" class="icon-button text-field-trailing" aria-label="Очистить" @onclick="ClearUrls"><Icon Name="close" /></button>
                }
            }
        </div>
        <p class="supporting-text">Или из браузера: «Поделиться» → «Скачать книгу (E2E)». Несколько ссылок — каждая с новой строки.</p>
    </div>

    @if (Downloads.IsRunning)
    {
        <!-- Идёт загрузка -->
        <section class="card card-padded" aria-label="Загрузка">
            @if (Downloads.Preview != null)
            {
                <ShortBook Book="Downloads.Preview" />
            }
            else
            {
                <div class="book-summary">
                    <div class="book-cover" aria-hidden="true"><span class="spinner"></span></div>
                    <div class="book-info">
                        <h2 class="book-title">Получаю данные о книге…</h2>
                        @if (CurrentHost != null)
                        {
                            <span class="book-host">@CurrentHost</span>
                        }
                    </div>
                </div>
            }
            <div class="stack">
                <div class="linear-progress" role="progressbar" aria-label="Идёт загрузка"></div>
                <p class="progress-status">@Downloads.Status</p>
            </div>
            <div class="row">
                @if (Downloads.ChaptersLoaded > 0)
                {
                    <span class="assist-chip">Глав: @Downloads.ChaptersLoaded</span>
                }
                @if (Downloads.Total > 1)
                {
                    <span class="assist-chip with-icon"><Icon Name="queue" Size="18" />Книга @Downloads.Current из @Downloads.Total</span>
                }
                <button type="button" class="btn btn-outlined push-end" @onclick="Downloads.Cancel">Отменить</button>
            </div>
        </section>
        <p class="supporting-text">Приложение можно свернуть: загрузка продолжится в фоне, прогресс — в уведомлении.</p>
    }
    else
    {
        <!-- Формат -->
        <section class="section" aria-label="Формат">
            <h2 class="section-label">Формат</h2>
            <div class="chip-set">
                @foreach (var (id, description) in FormatsInfo)
                {
                    var on = _formats.Contains(id);
                    <button type="button" class="filter-chip @(on ? "selected" : "")" aria-pressed="@(on ? "true" : "false")"
                            title="@description" @onclick="() => ToggleFormat(id)">
                        @if (on)
                        {
                            <Icon Name="check" Size="18" />
                        }
                        @id.ToUpperInvariant()
                    </button>
                }
            </div>
            <p class="supporting-text flush">EPUB и FB2 — для читалок, CBZ — комиксы и сканы, TXT — простой текст.</p>
        </section>

        <!-- Картинки, вход, диапазон глав -->
        <section class="card" aria-label="Параметры">
            <label class="list-item two-line">
                <span class="list-item-leading"><Icon Name="image" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Картинки в книге</span>
                    <span class="list-item-supporting">@(Settings.Images ? "Обложка и иллюстрации" : "Только текст — файл легче")</span>
                </span>
                <input type="checkbox" role="switch" class="switch" checked="@Settings.Images" @onchange="e => Settings.Images = (bool)e.Value!" />
            </label>

            <hr class="divider" />

            <button type="button" class="list-item two-line" aria-expanded="@(Form.ShowAuth ? "true" : "false")" @onclick="() => Form.ShowAuth = !Form.ShowAuth">
                <span class="list-item-leading"><Icon Name="lock" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Вход на сайт</span>
                    <span class="list-item-supporting">@AuthHint</span>
                </span>
                <Icon Name="chevron" Class="@($"chevron {(Form.ShowAuth ? "open" : "")}")" />
            </button>
            @if (Form.ShowAuth)
            {
                <div class="expand-body">
                    <div class="text-field">
                        <label class="text-field-label" for="login">Логин</label>
                        <input id="login" type="text" class="text-field-input" placeholder="Логин или почта" autocomplete="username" autocapitalize="off" spellcheck="false"
                               @bind="Form.Login" @bind:event="oninput" @bind:after="() => Form.CredentialsAutoFilled = false" />
                    </div>
                    <div class="text-field has-trailing">
                        <label class="text-field-label" for="password">Пароль</label>
                        <input id="password" type="@(_showPassword ? "text" : "password")" class="text-field-input" autocomplete="current-password"
                               @bind="Form.Password" @bind:event="oninput" @bind:after="() => Form.CredentialsAutoFilled = false" />
                        <button type="button" class="icon-button text-field-trailing" aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                                @onclick="() => _showPassword = !_showPassword">
                            <Icon Name="@(_showPassword ? "eye-off" : "eye")" />
                        </button>
                    </div>
                    <label class="checkbox-row">
                        <input type="checkbox" class="checkbox" @bind="Form.RememberCredentials" />
                        <span>Запомнить для @(CurrentHost ?? "этого сайта")</span>
                    </label>
                </div>
            }

            <hr class="divider" />

            <button type="button" class="list-item two-line" aria-expanded="@(Form.ShowRange ? "true" : "false")" @onclick="() => Form.ShowRange = !Form.ShowRange">
                <span class="list-item-leading"><Icon Name="range" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Диапазон глав</span>
                    <span class="list-item-supporting">@RangeHint</span>
                </span>
                <Icon Name="chevron" Class="@($"chevron {(Form.ShowRange ? "open" : "")}")" />
            </button>
            @if (Form.ShowRange)
            {
                <div class="expand-body">
                    <div class="segmented" role="group" aria-label="Как задать диапазон">
                        <button type="button" class="segment @(!Form.RangeByName ? "selected" : "")" aria-pressed="@(!Form.RangeByName ? "true" : "false")" @onclick="() => SwitchRange(false)">
                            @if (!Form.RangeByName)
                            {
                                <Icon Name="check" Size="18" />
                            }
                            По номеру
                        </button>
                        <button type="button" class="segment @(Form.RangeByName ? "selected" : "")" aria-pressed="@(Form.RangeByName ? "true" : "false")" @onclick="() => SwitchRange(true)">
                            @if (Form.RangeByName)
                            {
                                <Icon Name="check" Size="18" />
                            }
                            По названию
                        </button>
                    </div>
                    @if (Form.RangeByName)
                    {
                        <div class="grid-2">
                            <div class="text-field">
                                <label class="text-field-label" for="from">С главы</label>
                                <input id="from" type="text" class="text-field-input" placeholder="Пролог" @bind="Form.StartName" @bind:event="oninput" />
                            </div>
                            <div class="text-field">
                                <label class="text-field-label" for="to">По главу</label>
                                <input id="to" type="text" class="text-field-input" placeholder="Эпилог" @bind="Form.EndName" @bind:event="oninput" />
                            </div>
                        </div>
                        <p class="supporting-text flush">Названия глав — как на сайте книги.</p>
                    }
                    else
                    {
                        <div class="grid-2">
                            <div class="text-field">
                                <label class="text-field-label" for="from">С главы</label>
                                <input id="from" type="text" inputmode="numeric" class="text-field-input" placeholder="1" @bind="Form.StartNum" @bind:event="oninput" />
                            </div>
                            <div class="text-field">
                                <label class="text-field-label" for="to">По главу</label>
                                <input id="to" type="text" inputmode="numeric" class="text-field-input" placeholder="−3" @bind="Form.EndNum" @bind:event="oninput" />
                            </div>
                        </div>
                        <p class="supporting-text flush">Отрицательные числа считаются с конца: «−3» — три последние главы.</p>
                    }
                </div>
            }
        </section>

        <!-- Скачать -->
        <div class="stack">
            <button type="button" class="btn btn-filled btn-block" @onclick="Start">
                <Icon Name="download" Size="18" />Скачать
            </button>
            <p class="hint-row"><Icon Name="folder" Size="16" />Сохраняется в «@Storage.DestinationLabel»</p>
        </div>
    }

    @if (log.Count > 0)
    {
        <!-- Журнал -->
        <section class="card" aria-label="Журнал">
            <button type="button" class="list-item" aria-expanded="@(_showLog ? "true" : "false")" @onclick="ToggleLog">
                <span class="list-item-leading"><Icon Name="log" /></span>
                <span class="list-item-text"><span class="list-item-headline">Журнал</span></span>
                <span class="list-item-trailing-text">@Formatting.Plural(log.Count, "запись", "записи", "записей")</span>
                <Icon Name="chevron" Class="@($"chevron {(_showLog ? "open" : "")}")" />
            </button>
            @if (_showLog)
            {
                <pre id="log-view" class="log-view">@string.Join('\n', log.TakeLast(500))</pre>
                <div class="card-actions compact">
                    <button type="button" class="btn btn-text" @onclick="CopyLog"><Icon Name="copy" Size="18" />Скопировать журнал</button>
                </div>
            }
        </section>
    }
</div>

@code {
    private static readonly (string Id, string Description)[] FormatsInfo =
    [
        ("epub", "Универсальный формат для читалок"),
        ("fb2", "Популярный формат в России"),
        ("cbz", "Комиксы и сканы постранично"),
        ("txt", "Простой текст без оформления")
    ];

    private List<string> _formats = [];
    private bool _showPassword;
    private bool _showLog;

    private int UrlRows => Math.Clamp((Form.Urls ?? string.Empty).Count(c => c == '\n') + 1, 1, 6);

    private string CurrentHost => CredentialStore.NormalizeHost(Formatting.ParseUrls(Form.Urls).FirstOrDefault());

    private bool HasSavedLogin => CurrentHost != null && CurrentHost == Form.CredentialsHost && !string.IsNullOrEmpty(Form.Login);

    /// <summary>Подпись под «Вход на сайт»: что сейчас будет использовано.</summary>
    private string AuthHint
    {
        get
        {
            if (HasSavedLogin && Form.CredentialsAutoFilled)
            {
                return $"Сохранён для {CurrentHost}: {Form.Login}";
            }

            return string.IsNullOrWhiteSpace(Form.Login) ? "Необязательно" : $"Логин: {Form.Login}";
        }
    }

    /// <summary>Подпись под «Диапазон глав»: «Все главы» или заданные границы.</summary>
    private string RangeHint
    {
        get
        {
            var (from, to) = Form.RangeByName
                ? (Quote(Form.StartName), Quote(Form.EndName))
                : (Form.StartNum?.Trim(), Form.EndNum?.Trim());
            if (string.IsNullOrEmpty(from) && string.IsNullOrEmpty(to))
            {
                return "Все главы";
            }

            return $"С {(string.IsNullOrEmpty(from) ? "начала" : from)} по {(string.IsNullOrEmpty(to) ? "конец" : to)}";

            static string Quote(string name) => string.IsNullOrWhiteSpace(name) ? null : $"«{name.Trim()}»";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _formats = Settings.Formats.ToList();
        Downloads.Changed += OnChanged;
        SharedLinkInbox.Arrived += OnSharedLink;

        var shared = SharedLinkInbox.Take();
        if (shared != null)
        {
            await ApplySharedLink(shared);
        }
    }

    private void OnSharedLink() => InvokeAsync(async () =>
    {
        var shared = SharedLinkInbox.Take();
        if (shared != null)
        {
            await ApplySharedLink(shared);
            StateHasChanged();
        }
    });

    private async Task ApplySharedLink(string urls)
    {
        if (Downloads.IsRunning)
        {
            Toasts.Show("Сейчас идёт скачивание. Ссылку скопировал — вставьте её, когда закончится");
            await Clipboard.Default.SetTextAsync(urls);
            return;
        }

        Form.Urls = urls;
        Downloads.Dismiss();
        await OnUrlsChanged();

        if (Settings.AutoStartOnShare)
        {
            await Start();
        }
    }

    private async Task OnUrlsChanged()
    {
        // Подставляем сохранённый логин, когда в поле появилась ссылка на другой сайт
        var host = CurrentHost;
        if (host == null || host == Form.CredentialsHost)
        {
            return;
        }

        var credential = await Credentials.GetAsync(host);
        Form.CredentialsHost = host;
        if (credential != null)
        {
            Form.Login = credential.Login;
            Form.Password = credential.Password;
            Form.CredentialsAutoFilled = true;
        }
        else if (Form.CredentialsAutoFilled)
        {
            // не тащим подставленный логин другого сайта; введённое вручную не трогаем
            Form.Login = string.Empty;
            Form.Password = string.Empty;
            Form.CredentialsAutoFilled = false;
        }
    }

    private async Task Paste()
    {
        var text = await Clipboard.Default.GetTextAsync();
        var urls = Formatting.ParseUrls(text);
        if (urls.Count == 0)
        {
            Toasts.Show("В буфере обмена нет ссылки", ToastKind.Error);
            return;
        }

        Form.Urls = string.Join('\n', urls);
        await OnUrlsChanged();
    }

    private void ClearUrls()
    {
        Form.Urls = string.Empty;
    }

    private void ToggleFormat(string format)
    {
        if (!_formats.Remove(format))
        {
            _formats.Add(format);
        }

        Settings.Formats = _formats;
    }

    private void SwitchRange(bool byName)
    {
        Form.RangeByName = byName;
        Form.StartNum = Form.EndNum = Form.StartName = Form.EndName = string.Empty;
    }

    private async Task Start()
    {
        await Js.InvokeVoidAsync("e2e.blur");

        var urls = Formatting.ParseUrls(Form.Urls);
        if (urls.Count == 0)
        {
            Toasts.Show("Укажите ссылку на книгу", ToastKind.Error);
            return;
        }

        if (_formats.Count == 0)
        {
            Toasts.Show("Выберите формат", ToastKind.Error);
            return;
        }

        int? start = null, end = null;
        if (!Form.RangeByName)
        {
            if (!string.IsNullOrWhiteSpace(Form.StartNum))
            {
                if (!int.TryParse(Form.StartNum.Replace('−', '-').Trim(), out var s))
                {
                    Toasts.Show("«С главы» должно быть числом", ToastKind.Error);
                    return;
                }

                start = s;
            }

            if (!string.IsNullOrWhiteSpace(Form.EndNum))
            {
                if (!int.TryParse(Form.EndNum.Replace('−', '-').Trim(), out var e))
                {
                    Toasts.Show("«По главу» должно быть числом", ToastKind.Error);
                    return;
                }

                end = e;
            }
        }

        var hasLogin = !string.IsNullOrWhiteSpace(Form.Login) && !string.IsNullOrWhiteSpace(Form.Password);
        if (hasLogin && Form.RememberCredentials && CurrentHost != null)
        {
            await Credentials.SaveAsync(CurrentHost, new SiteCredential(Form.Login.Trim(), Form.Password));
            Form.CredentialsHost = CurrentHost;
        }

        Form.Urls = string.Join('\n', urls);
        _showLog = false;

        await Downloads.StartAsync(new DownloadRequest
        {
            Urls = urls,
            Formats = _formats.ToList(),
            Login = hasLogin ? Form.Login : null,
            Password = hasLogin ? Form.Password : null,
            NoImage = !Settings.Images,
            Start = start,
            End = end,
            StartName = Form.RangeByName ? Form.StartName : null,
            EndName = Form.RangeByName ? Form.EndName : null
        });
    }

    private async Task ToggleLog()
    {
        _showLog = !_showLog;
        if (_showLog)
        {
            StateHasChanged();
            await Js.InvokeVoidAsync("e2e.scrollToBottom", "log-view");
        }
    }

    private async Task CopyLog()
    {
        await Clipboard.Default.SetTextAsync(string.Join('\n', Downloads.Log));
        Toasts.Show("Журнал скопирован", ToastKind.Success, 3);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Downloads.Changed -= OnChanged;
        SharedLinkInbox.Arrived -= OnSharedLink;
    }
}
