@* E2E для Android — вкладка «Книги»: история скачанных файлов (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/books"
@implements IDisposable
@inject HistoryStore History
@inject IBookStorage Storage
@inject ToastService Toasts

<div class="page">
    <p class="page-intro">
        Сохраняются в «@Storage.DestinationLabel». Отправить на читалку — кнопка «Поделиться»:
        Telegram, почта, Send to Kindle, облако читалки.
    </p>

    @if (_items == null)
    {
        <div class="empty-state"><span class="spinner large"></span></div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <Icon Name="library" Size="48" />
            <p>Здесь появятся скачанные книги</p>
            <a class="btn btn-filled" href=""><Icon Name="download" Size="18" />Скачать книгу</a>
        </div>
    }
    else
    {
        <section class="card list" aria-label="Скачанные книги">
            @foreach (var file in _items)
            {
                var missing = _missing.Contains(file.Id);
                <FileRow File="file" Missing="missing" ShowBookTitle="true" ShowDate="true" @key="file.Id">
                    @if (_confirmId == file.Id)
                    {
                        <button type="button" class="btn btn-text btn-danger" @onclick="() => Delete(file)">Удалить</button>
                        <button type="button" class="btn btn-text" @onclick="() => _confirmId = null">Нет</button>
                    }
                    else
                    {
                        <button type="button" class="icon-button" @onclick="() => AskDelete(file, missing)"
                                aria-label="@(missing ? "Убрать из списка" : "Удалить файл")"><Icon Name="@(missing ? "close" : "delete")" /></button>
                    }
                </FileRow>
            }
        </section>
        <div class="row centered">
            <button type="button" class="btn btn-text" @onclick="ClearList">Очистить список (файлы останутся)</button>
        </div>
    }
</div>

@code {
    private List<SavedFile> _items;
    private HashSet<string> _missing = [];
    private string _confirmId;

    protected override async Task OnInitializedAsync()
    {
        History.Changed += OnChanged;
        await Reload();
    }

    private async Task Reload()
    {
        var items = History.Items.ToList();
        // Проверка, что файл ещё на месте: пользователь мог удалить его в «Файлах»
        var missing = await Task.Run(() => items.Where(f => !Storage.Exists(f)).Select(f => f.Id).ToHashSet());
        _items = items;
        _missing = missing;
    }

    private void AskDelete(SavedFile file, bool missing)
    {
        if (missing)
        {
            History.Remove(file.Id);
            return;
        }

        _confirmId = file.Id;
    }

    private void Delete(SavedFile file)
    {
        _confirmId = null;
        if (!Storage.Delete(file))
        {
            Toasts.Show("Файл не удалось удалить (возможно, он создан до переустановки приложения) — уберу из списка", ToastKind.Error);
        }

        History.Remove(file.Id);
    }

    private void ClearList()
    {
        History.Clear();
        Toasts.Show("Список очищен, файлы остались в папке", ToastKind.Info, 3);
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await Reload();
        StateHasChanged();
    });

    public void Dispose() => History.Changed -= OnChanged;
}
