@* E2E для Android — вкладка «Книги»: история загрузок, в том числе неудачных (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/books"
@implements IDisposable
@inject HistoryStore History
@inject IBookStorage Storage
@inject BookActions Actions
@inject ToastService Toasts
@inject NavigationManager Nav

<div class="page">
    <p class="page-intro">
        Сохраняются в «@Storage.DestinationLabel». Нажмите на книгу, чтобы посмотреть сведения о ней и файлы.
    </p>

    @if (_items == null)
    {
        <div class="empty-state"><span class="spinner large"></span></div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty-state">
            <Icon Name="library" Size="48" />
            <p>Здесь появятся скачанные книги</p>
            <a class="btn btn-filled" href=""><Icon Name="download" Size="18" />Скачать книгу</a>
        </div>
    }
    else
    {
        <section class="book-tiles" aria-label="Скачанные книги">
            @foreach (var item in _items)
            {
                var record = item.Record;
                <div class="book-tile @(record.Failed ? "failed" : "")" @key="record.Id">
                    <button type="button" class="book-tile-main" @onclick="() => Open(record)" aria-label="@(record.DisplayTitle + ": сведения о книге")">
                        <span class="book-cover tile">
                            @if (item.Cover != null)
                            {
                                <img src="@item.Cover" alt="" />
                            }
                            else
                            {
                                <Icon Name="@(record.Failed ? "error" : "book")" Size="24" />
                            }
                        </span>
                        <span class="book-tile-text">
                            <span class="book-tile-title">@record.DisplayTitle</span>
                            @if (!string.IsNullOrWhiteSpace(record.Author))
                            {
                                <span class="book-tile-meta">@record.Author</span>
                            }
                            @if (record.Failed)
                            {
                                <span class="book-tile-error"><Icon Name="error" Size="16" />Не скачалось: @record.Error</span>
                            }
                            else
                            {
                                <span class="book-tile-meta">@Meta(item)</span>
                            }
                        </span>
                    </button>
                    <div class="book-tile-actions">
                        @if (record.Failed || item.Missing)
                        {
                            <button type="button" class="icon-button" aria-label="Скачать заново" @onclick="() => Retry(record)"><Icon Name="retry" /></button>
                        }
                        else
                        {
                            <button type="button" class="icon-button" aria-label="Поделиться" @onclick="() => Actions.Share(record)"><Icon Name="share" /></button>
                        }
                    </div>
                </div>
            }
        </section>
        <div class="row centered">
            <button type="button" class="btn btn-text" @onclick="ClearList">Очистить список (файлы останутся)</button>
        </div>
    }
</div>

@code {
    private sealed record Item(BookRecord Record, string Cover, bool Missing);

    private List<Item> _items;

    protected override async Task OnInitializedAsync()
    {
        History.Changed += OnChanged;
        await Reload();
    }

    private async Task Reload()
    {
        var records = History.Records;
        // Обложки и проверка «файлы ещё на месте» — с диска и через ContentResolver, не в UI-потоке
        _items = await Task.Run(() => records
            .Select(r => new Item(r, BookActions.CoverDataUrl(r), !r.Failed && r.Files.Count > 0 && !r.Files.Any(Storage.Exists)))
            .ToList());
    }

    /// <summary>«EPUB · 1,4 МБ · 28.10.26 14:05», для удалённых файлов — пометка.</summary>
    private static string Meta(Item item)
    {
        var record = item.Record;
        var parts = new List<string>();
        var book = record.Files.FirstOrDefault(f => f.IsBook);
        if (book != null)
        {
            parts.Add(book.Extension.ToUpperInvariant());
            parts.Add(Formatting.Size(book.Size));
        }

        parts.Add(record.Date.LocalDateTime.ToString("dd.MM.yy HH:mm"));
        if (item.Missing)
        {
            parts.Add("файлы удалены");
        }

        return string.Join(" · ", parts);
    }

    private void Open(BookRecord record) => Nav.NavigateTo("books/" + record.Id);

    private async Task Retry(BookRecord record)
    {
        if (await Actions.RetryAsync(record))
        {
            Nav.NavigateTo("");
        }
    }

    private void ClearList()
    {
        History.Clear();
        Toasts.Show("Список очищен, файлы остались в папке", ToastKind.Info, 3);
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await Reload();
        StateHasChanged();
    });

    public void Dispose() => History.Changed -= OnChanged;
}
