@* E2E для Android — вкладка «Настройки» (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/settings"
@using System.Reflection
@inject AppSettings Settings
@inject IBookStorage Storage
@inject CredentialStore Credentials
@inject IPlatformServices Platform
@inject ToastService Toasts
@inject IJSRuntime Js

<div class="page">
    <section class="section">
        <h2 class="section-title">Сохранение</h2>
        <div class="card">
            <div class="list-item two-line">
                <span class="list-item-leading"><Icon Name="folder" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Папка</span>
                    <span class="list-item-supporting">@Storage.DestinationLabel</span>
                </span>
            </div>
            <div class="card-actions">
                <button type="button" class="btn btn-tonal" @onclick="PickFolder"><Icon Name="folder" Size="18" />Выбрать папку</button>
                @if (!string.IsNullOrEmpty(Settings.SaveFolderUri))
                {
                    <button type="button" class="btn btn-text" @onclick="ResetFolder">В «Загрузки»</button>
                }
            </div>
            <p class="card-note">Удобно выбрать папку, которую синхронизирует с читалкой Syncthing, Dropbox или облако читалки, — книги будут прилетать на неё сами.</p>

            <hr class="divider" />

            <div class="card-body">
                <div class="field">
                    <div class="text-field">
                        <label class="text-field-label" for="pattern">Шаблон имени файла</label>
                        <input id="pattern" class="text-field-input" @bind="_pattern" @bind:after="SavePattern" autocapitalize="off" spellcheck="false" />
                    </div>
                    <p class="supporting-text">По умолчанию: <code>@AppSettings.DefaultBookNamePattern</code></p>
                </div>
                <div class="chip-set">
                    @foreach (var token in PatternTokens)
                    {
                        <button type="button" class="assist-chip with-icon" @onclick="() => AddToken(token)"><Icon Name="plus" Size="18" />@token</button>
                    }
                </div>
            </div>

            <hr class="divider" />

            <label class="list-item">
                <span class="list-item-text"><span class="list-item-headline">Обложка отдельным файлом</span></span>
                <input type="checkbox" role="switch" class="switch" checked="@Settings.Cover" @onchange="e => Settings.Cover = (bool)e.Value!" />
            </label>

            <hr class="divider" />

            <label class="list-item two-line">
                <span class="list-item-text">
                    <span class="list-item-headline">Дополнительные файлы</span>
                    <span class="list-item-supporting">Вложения со страницы книги: аудио, файлы, картинки глав</span>
                </span>
                <input type="checkbox" role="switch" class="switch" checked="@Settings.Additional" @onchange="e => Settings.Additional = (bool)e.Value!" />
            </label>
            @if (Settings.Additional)
            {
                <div class="expand-body">
                    <div class="chip-set">
                        @foreach (var (id, title) in AdditionalTypes)
                        {
                            var on = IsAdditionalSelected(id);
                            <button type="button" class="filter-chip @(on ? "selected" : "")" aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleAdditional(id)">
                                @if (on)
                                {
                                    <Icon Name="check" Size="18" />
                                }
                                @title
                            </button>
                        }
                    </div>
                    <p class="supporting-text flush">Ничего не выбрано — все типы.</p>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Скачивание</h2>
        <div class="card">
            <div class="card-body">
                <h3 class="setting-title">Текстовый формат по умолчанию</h3>
                <div class="segmented" role="radiogroup" aria-label="Текстовый формат по умолчанию">
                    @foreach (var id in FormatSupport.TextFormats)
                    {
                        var on = Settings.TextFormat == id;
                        <button type="button" class="segment @(on ? "selected" : "")" role="radio" aria-checked="@(on ? "true" : "false")"
                                @onclick="() => Settings.TextFormat = id">
                            @if (on)
                            {
                                <Icon Name="check" Size="18" />
                            }
                            @id.ToUpperInvariant()
                        </button>
                    }
                </div>
                <p class="supporting-text flush">
                    Для книг и ранобэ: этот формат получает каждая новая ссылка. Манга и комиксы распознаются по сайту
                    и получают CBZ — поэтому после манги следующая книга снова будет в текстовом формате.
                    На главном экране формат можно поменять для одной ссылки.
                </p>
            </div>

            <hr class="divider" />

            <label class="list-item two-line">
                <span class="list-item-text">
                    <span class="list-item-headline wrap">Распознавать мангу и комиксы (экспериментально)</span>
                    <span class="list-item-supporting">Для сайтов с мангой и комиксами выбирать CBZ. Выключено — всем ссылкам текстовый формат по умолчанию</span>
                </span>
                <input type="checkbox" role="switch" class="switch" checked="@Settings.AutoFormat" @onchange="e => Settings.AutoFormat = (bool)e.Value!" />
            </label>

            <hr class="divider" />

            <div class="card-body">
                <h3 class="setting-title">Пропустить диалог скачивания</h3>
                <div class="segmented" role="radiogroup" aria-label="Пропустить диалог скачивания">
                    @foreach (var (value, title) in YesNo)
                    {
                        var on = Settings.AutoStartOnShare == value;
                        <button type="button" class="segment @(on ? "selected" : "")" role="radio" aria-checked="@(on ? "true" : "false")"
                                @onclick="() => Settings.AutoStartOnShare = value">
                            @if (on)
                            {
                                <Icon Name="check" Size="18" />
                            }
                            @title
                        </button>
                    }
                </div>
                <div class="setting-explain">
                    <p>
                        Касается ссылок, которыми вы делитесь в E2E из браузера или другого приложения
                        («Поделиться» → «Скачать книгу (E2E)»).
                    </p>
                    <p>
                        <b>Да</b> — книга начинает скачиваться сразу, без нажатия «Скачать». Формат выбирается сам: CBZ для
                        манги и комиксов, для остального — текстовый формат по умолчанию. Подставляется сохранённый вход на сайт,
                        главы — все, картинки — как в переключателе на главном экране. Ход загрузки виден на главном экране
                        и в шторке, там же её можно отменить.
                    </p>
                    <p>
                        <b>Нет</b> — ссылка только подставляется на главный экран: можно проверить формат, вход на сайт
                        и диапазон глав и нажать «Скачать» самому.
                    </p>
                    <p>Ссылки, вставленные в приложение вручную, всегда ждут нажатия «Скачать».</p>
                </div>
            </div>
        </div>
    </section>

    @if (Platform.SupportsDynamicColor)
    {
        <section class="section">
            <h2 class="section-title">Оформление</h2>
            <div class="card">
                <label class="list-item two-line">
                    <span class="list-item-leading"><Icon Name="theme" /></span>
                    <span class="list-item-text">
                        <span class="list-item-headline">Цвета из обоев</span>
                        <span class="list-item-supporting">Палитра телефона (Material You). В теме e-ink не используется; тему выбирают кнопкой вверху</span>
                    </span>
                    <input type="checkbox" role="switch" class="switch" checked="@_dynamicColor" @onchange="ToggleDynamicColor" />
                </label>
            </div>
        </section>
    }

    <section class="section">
        <h2 class="section-title">Сеть</h2>
        <div class="card card-body">
            <div class="grid-2">
                <div class="text-field">
                    <label class="text-field-label" for="timeout">Таймаут, сек</label>
                    <input id="timeout" class="text-field-input" type="number" inputmode="numeric" min="5" @bind="_timeout" @bind:after="SaveNumbers" />
                </div>
                <div class="text-field">
                    <label class="text-field-label" for="delay">Пауза, сек</label>
                    <input id="delay" class="text-field-input" type="number" inputmode="numeric" min="0" @bind="_delay" @bind:after="SaveNumbers" />
                </div>
            </div>
            <p class="supporting-text flush">Пауза — между запросами к сайту: помогает, если сайт ограничивает частые обращения.</p>

            <h3 class="section-label">Прокси</h3>
            <div class="segmented" role="radiogroup" aria-label="Тип прокси">
                @foreach (var (id, title) in ProxyTypes)
                {
                    var on = _proxyType == id;
                    <button type="button" class="segment @(on ? "selected" : "")" role="radio" aria-checked="@(on ? "true" : "false")" @onclick="() => SetProxyType(id)">
                        @title
                    </button>
                }
            </div>
            <div class="field">
                <div class="text-field">
                    <label class="text-field-label" for="proxy">Адрес и порт</label>
                    <input id="proxy" class="text-field-input" placeholder="127.0.0.1:1080" autocapitalize="off" spellcheck="false" inputmode="url"
                           @bind="_proxyAddress" @bind:after="SaveProxy" />
                </div>
                <p class="supporting-text">@(string.IsNullOrWhiteSpace(Settings.Proxy) ? "Пусто — без прокси." : $"Сейчас: {Settings.Proxy}")</p>
            </div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Входы на сайты</h2>
        <div class="card list">
            @if (_hosts.Count == 0 && _editHost == null)
            {
                <p class="card-note standalone">Пока нет. Вход сохраняется при скачивании, если в «Вход на сайт» отмечено «Запомнить», — или добавьте его здесь.</p>
            }

            @foreach (var host in _hosts)
            {
                @if (_editHost == host)
                {
                    @CredentialEditor
                }
                else
                {
                    <div class="list-item two-line has-actions">
                        <span class="list-item-leading"><Icon Name="person" /></span>
                        <span class="list-item-text">
                            <span class="list-item-headline">@host</span>
                            <span class="list-item-supporting">@(_logins.GetValueOrDefault(host) ?? "…")</span>
                        </span>
                        <button type="button" class="icon-button" @onclick="() => EditCredential(host)" aria-label="Изменить вход для @host"><Icon Name="edit" /></button>
                    </div>
                }
            }

            @if (_editHost == string.Empty)
            {
                @CredentialEditor
            }
            else if (_editHost == null)
            {
                <div class="card-actions">
                    <button type="button" class="btn btn-text" @onclick="AddCredential"><Icon Name="plus" Size="18" />Добавить вход</button>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">О приложении</h2>
        <div class="card list">
            <div class="list-item two-line">
                <span class="list-item-leading"><Icon Name="info" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">E2E для Android @Platform.AppVersion</span>
                    <span class="list-item-supporting">Сборка @Platform.BuildNumber@(string.IsNullOrEmpty(_commit) ? "" : $" · коммит {_commit}")</span>
                </span>
            </div>
            <div class="ai-note">
                <Icon Name="info" Size="20" />
                <span>Неофициальная сборка <b>AI Edition</b>: Android-приложение сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется.</span>
            </div>
            <div class="list-item two-line">
                <span class="list-item-leading"><Icon Name="library" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Ядро Elib2Ebook @_coreVersion</span>
                    <span class="list-item-supporting">Сайты и форматы — как в консольной и веб-версии</span>
                </span>
            </div>
            <a class="list-item two-line" href="https://github.com/AriKhelvi/Elib2Ebook4AndroidAIEDITION" target="_blank" rel="noopener">
                <span class="list-item-leading"><Icon Name="github" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Этот форк</span>
                    <span class="list-item-supporting">Исходники и сообщения об ошибках (Issues)</span>
                </span>
                <span class="list-item-trailing"><Icon Name="external" Size="20" /></span>
            </a>
            <a class="list-item two-line" href="https://github.com/OnlyFart/Elib2Ebook" target="_blank" rel="noopener">
                <span class="list-item-leading"><Icon Name="globe" /></span>
                <span class="list-item-text">
                    <span class="list-item-headline">Оригинальный Elib2Ebook</span>
                    <span class="list-item-supporting">OnlyFart/Elib2Ebook · лицензия GPL-3.0</span>
                </span>
                <span class="list-item-trailing"><Icon Name="external" Size="20" /></span>
            </a>
        </div>
    </section>
</div>

@code {
    private static readonly string[] PatternTokens = ["{Author.Name}", "{Book.Title}", "{Seria.Name}", "{Seria.Number}"];

    private static readonly (string Id, string Title)[] AdditionalTypes =
    [
        ("books", "Книги"),
        ("audio", "Аудио"),
        ("images", "Картинки")
    ];

    private static readonly (bool Value, string Title)[] YesNo = [(true, "Да"), (false, "Нет")];

    /// <summary>Схемы прокси, которые понимает HttpClient .NET 10 (https:// — TLS до самого прокси).</summary>
    private static readonly (string Id, string Title)[] ProxyTypes =
    [
        ("http", "HTTP"),
        ("https", "HTTPS"),
        ("socks4", "SOCKS4"),
        ("socks5", "SOCKS5")
    ];

    private string _pattern;
    private int _timeout;
    private int _delay;
    private string _proxyType = "http";
    private string _proxyAddress;
    private bool _dynamicColor = true;
    private IReadOnlyList<string> _hosts = [];
    private readonly Dictionary<string, string> _logins = [];
    private string _coreVersion;
    private string _commit;

    // Редактор входа: null — закрыт, "" — новый вход, иначе — сайт, который правим
    private string _editHost;
    private string _editSite;
    private string _editLogin;
    private string _editPassword;
    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        _pattern = Settings.BookNamePattern;
        _timeout = Settings.Timeout;
        _delay = Settings.Delay;
        ParseProxy(Settings.Proxy);

        // Версия ядра и коммит форка зашиваются при сборке (см. таргет E2ECoreVersion в E2E.Droid.csproj)
        var metadata = typeof(MauiProgram).Assembly.GetCustomAttributes<AssemblyMetadataAttribute>().ToList();
        _coreVersion = metadata.FirstOrDefault(m => m.Key == "Elib2EbookVersion")?.Value;
        _commit = metadata.FirstOrDefault(m => m.Key == "BuildCommit")?.Value;

        await LoadCredentials();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Platform.SupportsDynamicColor)
        {
            _dynamicColor = await Js.InvokeAsync<bool>("e2e.getDynamicEnabled");
            StateHasChanged();
        }
    }

    private async Task LoadCredentials()
    {
        _hosts = Credentials.Hosts;
        foreach (var host in _hosts)
        {
            _logins[host] = (await Credentials.GetAsync(host))?.Login ?? "логин не прочитан";
        }
    }

    private async Task PickFolder()
    {
        try
        {
            if (await Storage.PickFolderAsync())
            {
                Toasts.Show($"Книги будут сохраняться в «{Storage.DestinationLabel}»", ToastKind.Success);
            }
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Show(ex.Message, ToastKind.Error, 10);
        }
        catch (Exception ex)
        {
            Toasts.Show($"Не удалось выбрать папку: {ex.Message}", ToastKind.Error);
        }
    }

    private void ResetFolder()
    {
        Storage.ResetFolder();
        Toasts.Show($"Книги будут сохраняться в «{Storage.DestinationLabel}»", ToastKind.Info);
    }

    private void SavePattern()
    {
        Settings.BookNamePattern = _pattern;
        _pattern = Settings.BookNamePattern;
    }

    private void AddToken(string token)
    {
        _pattern = string.IsNullOrWhiteSpace(_pattern) ? token : $"{_pattern} {token}";
        SavePattern();
    }

    private void SaveNumbers()
    {
        Settings.Timeout = _timeout;
        Settings.Delay = _delay;
        _timeout = Settings.Timeout;
        _delay = Settings.Delay;
    }

    /// <summary>«socks5://127.0.0.1:1080» → тип socks5 и адрес «127.0.0.1:1080»; без схемы — HTTP.</summary>
    private void ParseProxy(string proxy)
    {
        proxy = proxy?.Trim() ?? string.Empty;
        var separator = proxy.IndexOf("://", StringComparison.Ordinal);
        var scheme = separator > 0 ? proxy[..separator].ToLowerInvariant() : null;
        if (scheme != null && ProxyTypes.Any(t => t.Id == scheme))
        {
            _proxyType = scheme;
            _proxyAddress = proxy[(separator + 3)..].TrimEnd('/');
        }
        else
        {
            _proxyAddress = separator > 0 ? proxy[(separator + 3)..].TrimEnd('/') : proxy;
        }
    }

    private void SetProxyType(string type)
    {
        _proxyType = type;
        SaveProxy();
    }

    private void SaveProxy()
    {
        // Вставили адрес целиком со схемой — разбираем заново
        if (_proxyAddress?.Contains("://", StringComparison.Ordinal) == true)
        {
            ParseProxy(_proxyAddress);
        }

        Settings.Proxy = string.IsNullOrWhiteSpace(_proxyAddress) ? string.Empty : $"{_proxyType}://{_proxyAddress.Trim()}";
    }

    private async Task ToggleDynamicColor(ChangeEventArgs e)
    {
        _dynamicColor = (bool)e.Value!;
        await Js.InvokeVoidAsync("e2e.setDynamicEnabled", _dynamicColor);
    }

    private bool IsAdditionalSelected(string id) => Settings.AdditionalTypes.Contains(id, StringComparer.OrdinalIgnoreCase);

    private void ToggleAdditional(string id)
    {
        var types = Settings.AdditionalTypes.ToList();
        if (types.RemoveAll(t => t.Equals(id, StringComparison.OrdinalIgnoreCase)) == 0)
        {
            types.Add(id);
        }

        Settings.AdditionalTypes = types;
    }

    // --- Входы на сайты ---------------------------------------------------------------------------

    private RenderFragment CredentialEditor => @<div class="expand-body credential-editor">
        @if (_editHost == string.Empty)
        {
            <div class="text-field">
                <label class="text-field-label" for="cred-site">Сайт</label>
                <input id="cred-site" class="text-field-input" placeholder="author.today или ссылка на книгу" autocapitalize="off" spellcheck="false" inputmode="url" @bind="_editSite" />
            </div>
        }
        else
        {
            <h3 class="section-label">@_editHost</h3>
        }
        <div class="text-field">
            <label class="text-field-label" for="cred-login">Логин</label>
            <input id="cred-login" class="text-field-input" autocomplete="off" autocapitalize="off" spellcheck="false" @bind="_editLogin" />
        </div>
        <div class="text-field has-trailing">
            <label class="text-field-label" for="cred-password">Пароль</label>
            <input id="cred-password" type="@(_showPassword ? "text" : "password")" class="text-field-input" autocomplete="off" @bind="_editPassword" />
            <button type="button" class="icon-button text-field-trailing" aria-label="@(_showPassword ? "Скрыть пароль" : "Показать пароль")"
                    @onclick="() => _showPassword = !_showPassword">
                <Icon Name="@(_showPassword ? "eye-off" : "eye")" />
            </button>
        </div>
        <div class="row">
            <button type="button" class="btn btn-tonal" @onclick="SaveCredential">Сохранить</button>
            <button type="button" class="btn btn-text" @onclick="CloseEditor">Отмена</button>
            @if (!string.IsNullOrEmpty(_editHost))
            {
                <button type="button" class="btn btn-text btn-danger push-end" @onclick="RemoveCredential">Удалить</button>
            }
        </div>
    </div>;

    private void AddCredential()
    {
        _editHost = string.Empty;
        _editSite = _editLogin = _editPassword = string.Empty;
        _showPassword = false;
    }

    private async Task EditCredential(string host)
    {
        var credential = await Credentials.GetAsync(host);
        _editHost = host;
        _editLogin = credential?.Login ?? string.Empty;
        _editPassword = credential?.Password ?? string.Empty;
        _showPassword = false;
    }

    private void CloseEditor()
    {
        _editHost = null;
        _editPassword = null;
    }

    private async Task SaveCredential()
    {
        var host = _editHost;
        if (string.IsNullOrEmpty(host))
        {
            // «author.today», «https://author.today/work/1» — приводим к сайту так же, как при скачивании
            var site = _editSite?.Trim() ?? string.Empty;
            host = CredentialStore.NormalizeHost(site.Contains("://", StringComparison.Ordinal) ? site : "https://" + site);
            if (string.IsNullOrEmpty(host))
            {
                Toasts.Show("Укажите сайт — например, author.today", ToastKind.Error);
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(_editLogin) || string.IsNullOrEmpty(_editPassword))
        {
            Toasts.Show("Нужны и логин, и пароль", ToastKind.Error);
            return;
        }

        if (!await Credentials.SaveAsync(host, new SiteCredential(_editLogin.Trim(), _editPassword)))
        {
            return; // Редактор остаётся открытым, введённые данные доступны для повторной попытки.
        }
        CloseEditor();
        await LoadCredentials();
        Toasts.Show($"Вход для {host} сохранён", ToastKind.Success, 3);
    }

    private async Task RemoveCredential()
    {
        var host = _editHost;
        if (!Credentials.Remove(host)) return;
        _logins.Remove(host);
        CloseEditor();
        await LoadCredentials();
        Toasts.Show($"Вход для {host} удалён", ToastKind.Info, 3);
    }
}
