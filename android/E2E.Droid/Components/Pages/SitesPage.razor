@* E2E для Android — вкладка «Сайты»: README ядра, сверенный с загрузчиками
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/sites"

<div class="page">
    <div class="page-header">
        <h1 class="page-title">Поддерживаемые сайты</h1>
        <p class="page-subtitle">
            Список из <a href="https://github.com/OnlyFart/Elib2Ebook#поддерживаемые-сайты" target="_blank" rel="noopener">README Elib2Ebook</a>,
            сверенный с загрузчиками ядра в этой сборке. Нажмите на сайт, найдите книгу и поделитесь ею в E2E.
        </p>
    </div>

    @if (_sites == null)
    {
        <div class="empty-state"><div class="google-spinner"></div></div>
    }
    else
    {
        <div class="supported-search">
            <Icon Name="search" Class="search-icon" />
            <input type="search" class="supported-input" placeholder="Поиск сайта…" @bind="_search" @bind:event="oninput" />
        </div>

        <div class="supported-sites">
            @foreach (var site in Filter(s => s.InReadme))
            {
                <a class="site-card @(site.HasGetter ? "" : "site-card-missing")" href="@site.Url" target="_blank" rel="noopener" @key="site.Url">
                    <div class="site-card-icon"><Icon Name="globe" Size="24" /></div>
                    <div class="site-card-info">
                        <span class="site-card-name">@site.Name</span>
                        @if (!site.HasGetter)
                        {
                            <span class="site-card-url">есть в README, но нет загрузчика в ядре</span>
                        }
                    </div>
                </a>
            }
        </div>

        @if (Filter(s => !s.InReadme).Count > 0)
        {
            <h2 class="section-title">Есть в ядре, но нет в README</h2>
            <div class="supported-sites">
                @foreach (var site in Filter(s => !s.InReadme))
                {
                    <a class="site-card" href="@site.Url" target="_blank" rel="noopener" @key="site.Url">
                        <div class="site-card-icon"><Icon Name="globe" Size="24" /></div>
                        <div class="site-card-info"><span class="site-card-name">@site.Name</span></div>
                    </a>
                }
            </div>
        }

        @if (Filter(_ => true).Count == 0)
        {
            <div class="supported-empty"><p>Ничего не найдено</p></div>
        }

        <p class="field-hint center">В README: @_sites.Count(s => s.InReadme) · работают в этой сборке: @_sites.Count(s => s.HasGetter)</p>
    }
</div>

@code {
    private string _search = string.Empty;
    private IReadOnlyList<SiteEntry> _sites;

    protected override async Task OnInitializedAsync()
    {
        // Первый раз ждёт загрузки сборок сайтов — не держим UI
        _sites = await Task.Run(() => SupportedSites.Sites);
    }

    private List<SiteEntry> Filter(Func<SiteEntry, bool> predicate)
        => _sites
            .Where(predicate)
            .Where(s => string.IsNullOrWhiteSpace(_search) || s.Url.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
}
