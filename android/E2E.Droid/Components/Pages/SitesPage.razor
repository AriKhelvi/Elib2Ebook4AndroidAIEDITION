@* E2E для Android — вкладка «Сайты»: README ядра, сверенный с загрузчиками (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@page "/sites"

<div class="page">
    <p class="page-intro">
        Список из <a href="https://github.com/OnlyFart/Elib2Ebook#поддерживаемые-сайты" target="_blank" rel="noopener">README Elib2Ebook</a>,
        сверенный с загрузчиками ядра этой сборки. Откройте сайт, найдите книгу и поделитесь ею в E2E.
    </p>

    @if (_sites == null)
    {
        <div class="empty-state"><span class="spinner large"></span></div>
    }
    else
    {
        var inReadme = Filter(s => s.InReadme);
        var coreOnly = Filter(s => !s.InReadme);

        <label class="search-bar">
            <Icon Name="search" />
            <input type="search" placeholder="Поиск сайта" aria-label="Поиск сайта" @bind="_search" @bind:event="oninput" />
        </label>

        @if (inReadme.Count > 0)
        {
            <section class="card list" aria-label="Сайты из README">
                @foreach (var site in inReadme)
                {
                    <a class="list-item @(site.HasGetter ? "" : "two-line")" href="@site.Url" target="_blank" rel="noopener" @key="site.Url">
                        <span class="list-item-leading"><Icon Name="globe" /></span>
                        <span class="list-item-text">
                            <span class="list-item-headline">@site.Name</span>
                            @if (!site.HasGetter)
                            {
                                <span class="list-item-supporting">есть в README, но нет загрузчика в ядре</span>
                            }
                        </span>
                        <span class="list-item-trailing"><Icon Name="external" Size="20" /></span>
                    </a>
                }
            </section>
        }

        @if (coreOnly.Count > 0)
        {
            <section class="section">
                <h2 class="section-title">Есть в ядре, но нет в README</h2>
                <div class="card list">
                    @foreach (var site in coreOnly)
                    {
                        <a class="list-item" href="@site.Url" target="_blank" rel="noopener" @key="site.Url">
                            <span class="list-item-leading"><Icon Name="globe" /></span>
                            <span class="list-item-text"><span class="list-item-headline">@site.Name</span></span>
                            <span class="list-item-trailing"><Icon Name="external" Size="20" /></span>
                        </a>
                    }
                </div>
            </section>
        }

        @if (inReadme.Count + coreOnly.Count == 0)
        {
            <div class="empty-state"><p>Ничего не найдено</p></div>
        }

        <p class="hint-row">В README: @_sites.Count(s => s.InReadme) · работают в этой сборке: @_sites.Count(s => s.HasGetter)</p>
    }
</div>

@code {
    private string _search = string.Empty;
    private IReadOnlyList<SiteEntry> _sites;

    protected override async Task OnInitializedAsync()
    {
        // Первый раз ждёт загрузки сборок сайтов — не держим UI
        _sites = await Task.Run(() => SupportedSites.Sites);
    }

    private List<SiteEntry> Filter(Func<SiteEntry, bool> predicate)
        => _sites
            .Where(predicate)
            .Where(s => string.IsNullOrWhiteSpace(_search) || s.Url.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();
}
