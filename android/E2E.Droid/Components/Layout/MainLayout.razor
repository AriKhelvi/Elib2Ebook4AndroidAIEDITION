@* E2E для Android — каркас: верхняя панель с меню темы, контент, нижняя навигация (Material 3)
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime Js
@inject DownloadManager Downloads
@inject NavigationManager Nav

<div class="app-shell">
    <header class="top-app-bar">
        <h1 class="top-app-bar-title">@Title</h1>
        @if (Downloads.IsRunning && !IsHome)
        {
            <NavLink class="top-bar-progress" href="" Match="NavLinkMatch.All">
                <span class="spinner small"></span>
                @(Downloads.Total > 1 ? $"Качаю {Downloads.Current}/{Downloads.Total}" : "Качаю")
            </NavLink>
        }
        <button type="button" class="icon-button @(_menuOpen ? "selected" : "")" aria-label="Тема оформления"
                aria-haspopup="menu" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="() => _menuOpen = !_menuOpen">
            <Icon Name="theme" />
        </button>
    </header>

    <main class="app-content">
        @Body
    </main>

    <nav class="nav-bar" aria-label="Разделы">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All" aria-label="@(Downloads.IsRunning ? "Скачать, идёт загрузка" : "Скачать")">
            <span class="nav-indicator">
                <Icon Name="download" />
                @if (Downloads.IsRunning)
                {
                    <span class="nav-badge"></span>
                }
            </span>
            <span>Скачать</span>
        </NavLink>
        <NavLink class="nav-item" href="books">
            <span class="nav-indicator"><Icon Name="library" /></span>
            <span>Книги</span>
        </NavLink>
        <NavLink class="nav-item" href="sites">
            <span class="nav-indicator"><Icon Name="globe" /></span>
            <span>Сайты</span>
        </NavLink>
        <NavLink class="nav-item" href="settings">
            <span class="nav-indicator"><Icon Name="settings" /></span>
            <span>Настройки</span>
        </NavLink>
    </nav>

    @if (_menuOpen)
    {
        @* Прозрачная подложка на весь экран: нажатие мимо меню закрывает его *@
        <button type="button" class="menu-scrim" aria-label="Закрыть меню" @onclick="() => _menuOpen = false"></button>
        <div class="menu" role="menu" aria-label="Тема оформления">
            @foreach (var (id, label, icon) in Themes)
            {
                var selected = id == _themeMode;
                <button type="button" class="menu-item @(selected ? "selected" : "")" role="menuitemradio"
                        aria-checked="@(selected ? "true" : "false")" @onclick="() => SetTheme(id)">
                    <span class="menu-item-icon"><Icon Name="@icon" /></span>
                    <span class="menu-item-label">@label</span>
                    <span class="menu-item-check">
                        @if (selected)
                        {
                            <Icon Name="check" />
                        }
                    </span>
                </button>
            }
        </div>
    }

    <Toasts />
</div>

@code {
    /// <summary>Темы для меню — те же значения, что понимает e2e.setThemeMode в js/app.js.</summary>
    private static readonly (string Id, string Label, string Icon)[] Themes =
    [
        ("system", "Как в системе", "theme"),
        ("light", "Светлая", "sun"),
        ("dark", "Тёмная", "moon"),
        ("amoled", "AMOLED", "amoled"),
        ("eink", "E-ink", "eink")
    ];

    private string _themeMode = "system";
    private bool _menuOpen;

    private string Route => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    private bool IsHome => Route.Length == 0;

    /// <summary>Заголовок верхней панели — название раздела (на главной — название программы).</summary>
    private string Title => Route switch
    {
        "books" => "Книги",
        "sites" => "Сайты",
        "settings" => "Настройки",
        _ => "Elib2Ebook"
    };

    protected override void OnInitialized()
    {
        Downloads.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        SharedLinkInbox.Arrived += OnSharedLink;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Тема уже применена скриптом до отрисовки — узнаём выбор для меню и красим системные панели
            _themeMode = await Js.InvokeAsync<string>("e2e.getThemeMode");
            await Js.InvokeVoidAsync("e2e.syncNative");
            StateHasChanged();
        }
    }

    private async Task SetTheme(string mode)
    {
        _menuOpen = false;
        _themeMode = mode;
        await Js.InvokeAsync<string>("e2e.setThemeMode", mode);
    }

    // Ссылка пришла через «Поделиться», а открыта другая вкладка — переходим на главную, она заберёт ссылку
    private void OnSharedLink() => InvokeAsync(() =>
    {
        if (!IsHome)
        {
            Nav.NavigateTo("");
        }
    });

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        _menuOpen = false;
        StateHasChanged();
    });

    public void Dispose()
    {
        Downloads.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
        SharedLinkInbox.Arrived -= OnSharedLink;
    }
}
