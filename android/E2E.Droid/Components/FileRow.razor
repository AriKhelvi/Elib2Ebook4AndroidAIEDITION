@* E2E для Android — строка файла: значок формата, название, размер; открыть / поделиться / удалить
   [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md. *@
@inject IBookStorage Storage
@inject ToastService Toasts

<div class="list-item two-line has-actions file-row @(Missing ? "missing" : "")">
    <span class="file-badge" aria-hidden="true">@Badge</span>
    <div class="list-item-text">
        <span class="list-item-headline">@(ShowBookTitle && !string.IsNullOrEmpty(File.BookTitle) ? File.BookTitle : File.Name)</span>
        <span class="list-item-supporting">
            @if (ShowBookTitle && !string.IsNullOrEmpty(File.Author))
            {
                @File.Author<text> · </text>
            }
            @if (Missing)
            {
                <span class="file-missing">файл удалён</span>
            }
            else
            {
                @Formatting.Size(File.Size)
                @if (ShowDate)
                {
                    <text> · </text>@File.SavedAt.LocalDateTime.ToString("dd.MM.yy HH:mm")
                }
            }
        </span>
    </div>
    <div class="list-item-trailing">
        @if (!Missing)
        {
            <button type="button" class="icon-button" @onclick="Open" aria-label="Открыть @File.Name"><Icon Name="open" /></button>
            <button type="button" class="icon-button" @onclick="() => Storage.Share([File])" aria-label="Поделиться @File.Name"><Icon Name="share" /></button>
        }
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SavedFile File { get; set; }

    [Parameter] public bool Missing { get; set; }

    [Parameter] public bool ShowBookTitle { get; set; }

    [Parameter] public bool ShowDate { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    /// <summary>«EPUB», «FB2», «JPG»… — не длиннее четырёх букв, чтобы влезло в значок.</summary>
    private string Badge
    {
        get
        {
            var extension = (File.Extension ?? string.Empty).ToUpperInvariant();
            return extension.Length > 4 ? extension[..4] : extension;
        }
    }

    private void Open()
    {
        if (!Storage.Open(File))
        {
            Toasts.Show($"Нет приложения, которое открывает .{File.Extension}. Установите читалку или отправьте файл через «Поделиться»", ToastKind.Error, 8);
        }
    }
}
