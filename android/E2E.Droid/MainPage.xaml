<?xml version="1.0" encoding="utf-8" ?>
<!--
  E2E для Android — единственная страница MAUI: BlazorWebView на весь экран
  [AI-EDITION] Сгенерировано ИИ (Claude, Anthropic) под присмотром человека. Стабильность не гарантируется — см. android/README.md.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:E2E.Droid.Components"
             xmlns:local="clr-namespace:E2E.Droid"
             x:Class="E2E.Droid.MainPage"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light=#F8F9FF, Dark=#111418}">

    <!-- AppBlazorWebView — BlazorWebView, который ещё отдаёт миниатюры обложек (/_covers/…, см. AppBlazorWebView.cs) -->
    <local:AppBlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <local:AppBlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </local:AppBlazorWebView.RootComponents>
    </local:AppBlazorWebView>

</ContentPage>
